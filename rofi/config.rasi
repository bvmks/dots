configuration {
    // modes: [combi];
    // modi: "drun";
    // combi-modes: "window,drun,run";
    font: "Iosevka Term Extended 13";
	location: 6;
	yoffset: -26;
	xoffset: 0;

    sort: true;
    sorting-method: "fzf";
    disable-history: false;
    matching: "fuzzy";
    // auto-select: true;

    terminal: "kitty";

    case-smart: true;
    scroll-method: 1;
    transient-window: true;

    run-command: "bash -c {cmd}";
    
    fixed-num-lines: false;
    combi-hide-mode-prefix: true;
    combi-display-format: "{mode}{text}";
    drun-display-format: "{name}";

    parse-hosts: false;
    parse-known-hosts: false;

	show-icons: true;
	// case-sensitive: false;
	steal-focus: true;
/*	display-window: ;*/
/*	display-windowcd: ;*/
	display-run: "";
/*	display-ssh: ;*/
	display-drun: "";

	kb-clear-line: ",Control+w";
	kb-row-left: "Alt+h,Control+Page_Up";
	kb-row-right: "Alt+l,Control+Page_Down";
	kb-row-up: "Alt+k,Up,Control+p";
	kb-row-down: "Alt+j,Down,Control+n";

  window {
      hide-active-window: true;
  }
  timeout {
      action: "kb-cancel";
      delay:  0;
  }
  filebrowser {
      directories-first: true;
      sorting-method:    "name";
  }
}

* {
    acent:                       #C43400;
    selected-normal-foreground:  @acent;
    foreground:                  #C5C8C6;
    normal-foreground:           @foreground;
    alternate-normal-background: rgba ( 39, 40, 34, 0 % );
    red:                         rgba ( 220, 50, 47, 100 % );
    selected-urgent-foreground:  rgba ( 248, 248, 242, 100 % );
    blue:                        rgba ( 38, 139, 210, 100 % );
    urgent-foreground:           rgba ( 249, 38, 114, 100 % );
    alternate-urgent-background: rgba ( 39, 40, 34, 0 % );
    active-foreground:           rgba ( 166, 226, 42, 100 % );
    lightbg:                     rgba ( 238, 232, 213, 100 % );
    selected-active-foreground:  rgba ( 166, 226, 42, 100 % );
    alternate-active-background: rgba ( 39, 40, 34, 0 % );
    background:                  #000000;
    bordercolor:                 rgba ( 0, 43, 54, 100 % );
    alternate-normal-foreground: @foreground;
    normal-background:           rgba ( 39, 40, 34, 0 % );
    lightfg:                     rgba ( 88, 104, 117, 100 % );
    selected-normal-background:  rgba ( 20, 20, 17, 100 % );
    // border-color:                #ff0000;
    spacing:                     2;
    separatorcolor:              @background;
    urgent-background:           rgba ( 39, 40, 34, 0 % );
    selected-urgent-background:  rgba ( 249, 38, 114, 100 % );
    alternate-urgent-foreground: @urgent-foreground;
    background-color:            rgba ( 0, 0, 0, 0 % );
    alternate-active-foreground: @active-foreground;
    active-background:           rgba ( 39, 40, 34, 0 % );
    selected-active-background:  rgba ( 20, 20, 17, 100 % );
}

window {
    background-color: @background;
    border:           0;
    padding:          5 10;
    width: 100%;
    // height: 250px;
}
mainbox {
    border:  0;
    padding: 0;
    children: [listview, inputbar];
}
message {
    // border-color: @separatorcolor;
    padding:      1px ;
}
textbox {
    text-color: @foreground;
}
listview {
    // dynamic: true;
    reverse: true;
    // fixed-height: 0;
    // border-color: @separatorcolor;
    spacing:      2px ;
    scrollbar:    false;
}
element {
    border:  0;
    padding: 1px ;
}
element-text {
    background-color: inherit;
    text-color:       inherit;
}
element.normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}
element.normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}
element.normal.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}
element.selected.normal {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}
element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}
element.selected.active {
    background-color: @selected-active-background;
    text-color:       @selected-active-foreground;
}
element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color:       @alternate-normal-foreground;
}
element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color:       @alternate-urgent-foreground;
}
element.alternate.active {
    background-color: @alternate-active-background;
    text-color:       @alternate-active-foreground;
}
mode-switcher {
    foreground-color: @background;
    // border:       0px 0px 2px ;
    // border-color: @separatorcolor;
}
button.selected {
    background-color: @background;
    text-color:       @selected-normal-foreground;
}
inputbar {
    spacing:    0;
    text-color: @normal-foreground;
    padding:    1px ;
}
entry {
    expand:     true;
    placeholder: "cmd";
    spacing:    0;
    text-color: @normal-foreground;
}
inputbar {
    children:   [textbox-prompt-colon,entry,mode-switcher];
}
textbox-prompt-colon {
    expand:     false;
    str:        " >";
    margin:     0px 0.3em 0em 0em ;
    text-color: #cc3500;
    font:       "Iosevka Term Extended Bold 13";
}
